{
  "name": "dsh-plugin-chart",
  "version": "0.1.0",
  "description": "Community DeepSeek Harness plugin that bundles the AntV chart visualization skill and a native chart-generation tool.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "rimraf lib && tsc -p tsconfig.build.json",
    "check": "prettier --check . && tsc -p tsconfig.json --noEmit && vitest run --coverage && rimraf lib && tsc -p tsconfig.build.json && publint",
    "clean": "rimraf lib coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "prettier --check . && tsc -p tsconfig.json --noEmit",
    "prepare": "rimraf lib && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "antv",
    "chart",
    "data-visualization",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "skill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxfu1/dsh-plugin-chart.git"
  },
  "homepage": "https://github.com/lxfu1/dsh-plugin-chart#readme",
  "bugs": {
    "url": "https://github.com/lxfu1/dsh-plugin-chart/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.1",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.1",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "4.1.11",
    "prettier": "^3.6.2",
    "publint": "^0.3.12",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  }
}
